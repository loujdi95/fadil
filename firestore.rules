rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Réglages publics (dispos, jours off) : lecture publique, écriture admin
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Galerie : lecture publique, écriture admin
    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Réservations : AUCUN accès public.
    // Les clients réservent via le serveur (/api/book), qui ne renvoie
    // que les créneaux pris (/api/slots) — jamais nom, tél ou e-mail.
    match /bookings/{doc} {
      allow read, update, delete: if request.auth != null;
      allow create: if false;
    }

    // Données privées (lien agenda iPhone) : admin uniquement
    match /private/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
